<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>{{PROJECT_NAME}}</AssemblyName>
    <RootNamespace>{{PROJECT_NAME}}</RootNamespace>
  </PropertyGroup>

  <!--
    Microsoft.Extensions.Hosting, .Configuration.EnvironmentVariables and
    .Logging.Console are NOT referenced here: net10.0's Microsoft.AspNetCore.App
    shared framework already provides them, and NuGet raises NU1510 for each,
    which TreatWarningsAsErrors turns into a failed restore.
  -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
  </ItemGroup>

</Project>
